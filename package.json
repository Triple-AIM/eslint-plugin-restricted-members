{
  "name": "eslint-plugin-restricted-members",
  "version": "0.1.0",
  "description": "A type-aware ESLint rule that bans chosen members on chosen TypeScript types.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@typescript-eslint/type-utils": "8.66.0",
    "@typescript-eslint/utils": "8.66.0",
    "ts-api-utils": "^2.5.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": ">=4.8.4 <6.1.0",
    "typescript-eslint": "^8.66.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@typescript-eslint/parser": "8.66.0",
    "@typescript-eslint/rule-tester": "8.66.0",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "^4.1.11"
  }
}
